# GateDemo environment variables
# Copy to .env and fill in values for your environment

# ============= Profiles =============
# Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=dev

# ============= Secrets =============
# JWT signing secret (gate-service, login-service)
JWT_SECRET=your-jwt-secret-key

# TLS settings (prod only)
TLS_ENABLED=true
TLS_CERT_PATH=/path/to/cert.pem
TLS_KEY_PATH=/path/to/key.pem

# ============= Redis =============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redistest

# ============= Gate Service =============
GATE_ID=gate-01
GATE_PORT=8888
HEALTH_PORT=8890

# ============= Game Service =============
GAME_ID=1001
GRPC_PORT=9090
